# Copy to .env and adjust. All values are optional; defaults are shown.

# SQLite database file (relative paths resolve from the repo root)
DATABASE_PATH=data/plan-app.sqlite

# Ports
API_PORT=8787
WEB_PORT=5173

# Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Origin the browser uses; links in emails point here
WEB_ORIGIN=http://localhost:5173

# Google sign-in (optional). Without both values, the Google button is hidden.
# See README → "Google sign-in" for how to create these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
